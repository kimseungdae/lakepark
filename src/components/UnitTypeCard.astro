---
import type { UnitGuideEntry } from '../data/complex/unitGuide';
import type { UnitType } from '../data/presets/geomdan-lakepark';
import { formatKRW, formatRange } from '../lib/format';
import SourceBadge from './SourceBadge.astro';

/**
 * 타입 요약 카드. 접힌 상태는 코드+전용면적+한 줄 요약이 전부.
 * 가격·면적은 프리셋(GEOMDAN_LAKEPARK)에서 내려받아 표시한다 — 데이터 중복 저장 금지.
 */
interface Props {
  entry: UnitGuideEntry;
  ab22?: UnitType;
  ab23?: UnitType;
}

const { entry, ab22, ab23 } = Astro.props;
const area = (ab23 ?? ab22)?.exclusiveAreaSqm;

const blockRows = [
  { label: 'AB22BL', type: ab22 },
  { label: 'AB23BL', type: ab23 },
].filter((row): row is { label: string; type: UnitType } => row.type !== undefined);
---

<article class="card ut-card" id={`type-${entry.code}`}>
  <div class="ut-head">
    <h3 class="ut-code">{entry.code}</h3>
    {area && <span class="ut-area">전용 {area.toFixed(2)}㎡</span>}
  </div>
  <p class="ut-highlight">{entry.highlight}</p>

  <details class="ut-more">
    <summary>가격·특징·해석 보기</summary>

    <table class="mini">
      <tbody>
        {
          blockRows.map((row) => (
            <tr>
              <th>{row.label} 공급금액</th>
              <td class="num">
                {formatRange(row.type.supplyPrice)}
                {row.type.typicalMinPrice && (
                  <span class="ut-typical">일반 최저 {formatKRW(row.type.typicalMinPrice)}</span>
                )}
              </td>
            </tr>
          ))
        }
        <tr>
          <th>발코니 확장</th>
          <td class="num">
            {
              blockRows
                .map((row) =>
                  row.type.balconyExpansion
                    ? `${row.label} ${formatKRW(row.type.balconyExpansion)}`
                    : `${row.label} 공고 확인 필요`,
                )
                .join(' · ')
            }
          </td>
        </tr>
      </tbody>
    </table>

    <h4>공고에서 확인된 특징 <span class="badge conf">확정</span></h4>
    <ul>
      {entry.confirmed.map((line) => <li>{line}</li>)}
    </ul>

    <h4>생활 해석 <span class="badge est">의견</span></h4>
    <ul>
      {entry.interpretation.map((line) => <li>{line}</li>)}
    </ul>

    <p class="ut-source"><SourceBadge source={entry.source} /></p>
  </details>
</article>

<style>
  .ut-card {
    margin-bottom: 0.75rem;
  }
  .ut-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }
  .ut-code {
    font-size: 1.05rem;
    margin: 0;
  }
  .ut-area {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .ut-highlight {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }
  .ut-more {
    border-top: 1px solid var(--border);
    padding-top: 0.5rem;
  }
  .ut-more summary {
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .ut-more table {
    margin: 0.6rem 0;
  }
  .ut-typical {
    display: block;
    font-size: 0.74rem;
    color: var(--text-muted);
  }
  .ut-more h4 {
    font-size: 0.8rem;
    margin: 0.75rem 0 0.3rem;
  }
  .ut-more ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.84rem;
  }
  .ut-more li {
    margin-bottom: 0.2rem;
  }
  .ut-source {
    margin: 0.6rem 0 0;
  }
</style>
