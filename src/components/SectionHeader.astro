---
interface Props {
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const { title, description, href, linkLabel = '전체 보기' } = Astro.props;
---

<header class="mb-4 flex items-end justify-between gap-4 border-b border-ink pb-3">
  <div>
    <h2 class="m-0 text-xl font-[760] text-ink sm:text-2xl">{title}</h2>
    {description && <p class="mt-1 mb-0 text-sm text-muted">{description}</p>}
  </div>
  {href && <a class="shrink-0 text-xs font-semibold text-muted no-underline hover:text-action" href={href}>{linkLabel} →</a>}
</header>
