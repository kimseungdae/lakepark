---
import { SITE } from '../data/site';

/**
 * 구독 CTA. SITE.stibeeFormAction이 비어 있으면 아무것도 렌더링하지 않는다.
 * 구독은 이 사이트의 유일한 KPI(3개월 내 100명)이므로 페이지 맥락에 맞는 카피로 노출한다.
 */
interface Props {
  context?: 'home' | 'status' | 'timeline' | 'calculator';
}

const { context = 'home' } = Astro.props;

const COPY: Record<NonNullable<Props['context']>, { title: string; lead: string }> = {
  home: {
    title: '입주 준비 알림 받기',
    lead: '중도금 회차, 입주지정일 확정, 사전점검 일정처럼 놓치기 쉬운 시점을 메일로 알려드립니다.',
  },
  status: {
    title: '상태판이 바뀌면 알려드립니다',
    lead: '5호선·학교·공원 같은 개발계획의 단계가 실제로 바뀔 때만 메일을 보냅니다. 광고성 메일은 없습니다.',
  },
  timeline: {
    title: '다음 일정을 놓치지 마세요',
    lead: '중도금 납부일과 입주 관련 공식 일정이 다가오면 미리 알려드립니다.',
  },
  calculator: {
    title: '입주 준비 알림 받기',
    lead: '중도금 회차, 입주지정일 확정, 사전점검 일정처럼 놓치기 쉬운 시점을 메일로 알려드립니다.',
  },
};

const copy = COPY[context];
---

{
  SITE.stibeeFormAction && (
    <section class="card subscribe">
      <h2 class="card-title">{copy.title}</h2>
      <p class="hint">{copy.lead}</p>
      <form action={SITE.stibeeFormAction} method="post" target="_blank" class="subscribe-form">
        <div class="subscribe-row">
          <input type="email" name="email" required placeholder="이메일 주소" aria-label="이메일 주소" />
          <button type="submit">알림 신청</button>
        </div>
        <label class="check">
          <input type="checkbox" name="agree_email" value="Y" required />
          <span>이메일 수신에 동의합니다. 언제든 수신거부할 수 있습니다.</span>
        </label>
      </form>
      <p class="hint">
        구독 정보는 스티비에 위탁 보관되며 이 사이트 서버에는 저장되지 않습니다.
        자세한 내용은 <a href="/privacy">개인정보 처리방침</a>을 확인하세요.
      </p>
    </section>
  )
}

<script>
  import { trackOnce } from '../lib/analytics';

  // 구독 전환은 KPI다. 폼이 스티비로 넘어가기 직전에 한 번만 계측한다.
  document.querySelectorAll<HTMLFormElement>('form.subscribe-form').forEach((form) => {
    form.addEventListener('submit', () => trackOnce('subscribe_converted'));
  });
</script>

<style>
  .subscribe-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .subscribe-row button {
    font: inherit;
    font-weight: 600;
    padding: 0.5rem 1rem;
    white-space: nowrap;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    cursor: pointer;
  }
</style>
