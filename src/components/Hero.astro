---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

/**
 * 페이지 상단 비주얼. public/images/<image> 파일이 있으면 그 이미지를 쓰고,
 * 없으면 자체 제작 SVG 일러스트(호수·공원·아파트 실루엣)로 폴백한다.
 *
 * AI 생성 이미지를 쓸 때는 caption으로 반드시 출처를 밝힌다 — 실제 단지 모습으로
 * 오인되면 오정보 원칙 위반이다. 시공사 조감도·투시도는 저작권 원칙상 넣지 않는다.
 */
interface Props {
  /** public/images/ 안의 파일명 (예: 'hero-lake.jpg') */
  image: string;
  alt: string;
  /** true면 이미지 파일이 없을 때 아무것도 렌더링하지 않는다 (SVG 폴백 생략) */
  optional?: boolean;
  caption?: string;
}

const { image, alt, optional = false, caption } = Astro.props;
// import.meta.url은 번들 위치를 가리키므로 프로젝트 루트(astro build의 cwd) 기준으로 찾는다.
const hasImage = existsSync(resolve(process.cwd(), 'public', 'images', image));
---

{
  hasImage ? (
    <figure class="hero">
      <img src={`/images/${image}`} alt={alt} loading="eager" decoding="async" />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  ) : (
    !optional && (
      <figure class="hero">
        <svg viewBox="0 0 1600 560" preserveAspectRatio="xMidYMid slice" role="img" aria-label={alt}>
          <defs>
            <linearGradient id="h-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#2b4674" />
              <stop offset="0.55" stop-color="#7e9dc8" />
              <stop offset="1" stop-color="#f3cda2" />
            </linearGradient>
            <linearGradient id="h-water" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#e9bd90" />
              <stop offset="0.3" stop-color="#7e9cc3" />
              <stop offset="1" stop-color="#374f78" />
            </linearGradient>
            <linearGradient id="h-tower" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#46587c" />
              <stop offset="1" stop-color="#2d3c58" />
            </linearGradient>
          </defs>

          <!-- 하늘·노을 -->
          <rect width="1600" height="380" fill="url(#h-sky)" />
          <circle cx="1180" cy="290" r="46" fill="#ffd9a0" opacity="0.95" />
          <circle cx="1180" cy="290" r="86" fill="#ffd9a0" opacity="0.22" />

          <!-- 먼 능선 -->
          <path d="M0 330 Q 220 296 430 322 T 860 318 T 1290 314 T 1600 310 V 380 H 0 Z" fill="#5c73a0" opacity="0.55" />

          <!-- 아파트 실루엣 (좌측 단지) -->
          <g fill="url(#h-tower)">
            <rect x="120" y="150" width="64" height="230" rx="4" />
            <rect x="200" y="110" width="72" height="270" rx="4" />
            <rect x="288" y="170" width="60" height="210" rx="4" />
            <rect x="404" y="140" width="68" height="240" rx="4" />
            <rect x="488" y="185" width="58" height="195" rx="4" />
          </g>
          <!-- 아파트 실루엣 (우측 단지) -->
          <g fill="#3a4c6e">
            <rect x="1310" y="160" width="62" height="220" rx="4" />
            <rect x="1388" y="120" width="70" height="260" rx="4" />
            <rect x="1472" y="178" width="58" height="202" rx="4" />
          </g>
          <!-- 불 켜진 창 -->
          <g fill="#ffd9a0" opacity="0.85">
            <rect x="214" y="140" width="10" height="14" rx="1.5" />
            <rect x="236" y="180" width="10" height="14" rx="1.5" />
            <rect x="214" y="252" width="10" height="14" rx="1.5" />
            <rect x="252" y="300" width="10" height="14" rx="1.5" />
            <rect x="134" y="200" width="9" height="13" rx="1.5" />
            <rect x="160" y="266" width="9" height="13" rx="1.5" />
            <rect x="420" y="176" width="10" height="14" rx="1.5" />
            <rect x="444" y="238" width="10" height="14" rx="1.5" />
            <rect x="1402" y="152" width="10" height="14" rx="1.5" />
            <rect x="1428" y="216" width="10" height="14" rx="1.5" />
            <rect x="1326" y="250" width="9" height="13" rx="1.5" />
          </g>

          <!-- 수변 숲 -->
          <g fill="#2e5d4a">
            <ellipse cx="80" cy="372" rx="90" ry="26" />
            <ellipse cx="240" cy="378" rx="110" ry="24" />
            <ellipse cx="430" cy="374" rx="95" ry="26" />
            <ellipse cx="640" cy="378" rx="120" ry="22" />
            <ellipse cx="880" cy="374" rx="100" ry="24" />
            <ellipse cx="1120" cy="378" rx="115" ry="22" />
            <ellipse cx="1350" cy="374" rx="100" ry="25" />
            <ellipse cx="1540" cy="378" rx="90" ry="23" />
          </g>

          <!-- 호수 -->
          <rect y="380" width="1600" height="180" fill="url(#h-water)" />
          <g fill="#ffffff" opacity="0.35">
            <rect x="220" y="420" width="170" height="4" rx="2" />
            <rect x="520" y="452" width="120" height="4" rx="2" />
            <rect x="900" y="430" width="200" height="4" rx="2" />
            <rect x="1250" y="470" width="150" height="4" rx="2" />
            <rect x="120" y="490" width="140" height="4" rx="2" />
            <rect x="700" y="500" width="180" height="4" rx="2" />
          </g>
          <g fill="#ffd9a0" opacity="0.4">
            <rect x="1130" y="408" width="100" height="5" rx="2.5" />
            <rect x="1160" y="436" width="60" height="4" rx="2" />
          </g>

          <!-- 새 -->
          <g stroke="#2d3c58" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.7">
            <path d="M700 150 q 12 -12 24 0 q 12 -12 24 0" />
            <path d="M780 190 q 9 -9 18 0 q 9 -9 18 0" />
            <path d="M640 210 q 7 -7 14 0 q 7 -7 14 0" />
          </g>
        </svg>
        <figcaption>일러스트 — 실제 단지·주변 모습과 다릅니다</figcaption>
      </figure>
    )
  )
}

<style>
  .hero {
    margin: 0 0 1.75rem;
  }
  .hero img,
  .hero svg {
    display: block;
    width: 100%;
    height: clamp(180px, 34vw, 330px);
    object-fit: cover;
    border-radius: 16px;
  }
  .hero figcaption {
    margin-top: 0.35rem;
    font-size: 0.74rem;
    color: var(--text-muted);
    text-align: right;
  }
</style>
