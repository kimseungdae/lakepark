---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Base title="우리 집 비용 계산" description="동, 층, 타입만 고르면 공식 분양가와 입주 자금 계획을 바로 확인합니다.">
  <header class="mx-auto mb-10 max-w-3xl">
    <p class="mb-3 text-sm font-bold text-action">우리 집 비용 계산</p>
    <h1 class="mb-4">동·층·타입만 고르면<br />필요한 돈이 보입니다</h1>
    <p class="m-0 max-w-2xl text-[1.05rem] leading-7 text-muted">
      공고 가격표에서 해당 금액을 찾아 계약금부터 입주 준비비까지 한 번에 정리합니다.
      날짜와 대출 조건은 기본값으로 먼저 계산하고 나중에 바꿀 수 있습니다.
    </p>
  </header>

  <div class="mx-auto grid max-w-5xl gap-8 lg:grid-cols-[minmax(0,380px)_minmax(0,1fr)] lg:items-start">
    <section class="rounded-2xl border border-line bg-canvas p-5 lg:sticky lg:top-32" aria-labelledby="home-select-title">
      <div class="mb-5 flex items-center justify-between">
        <h2 id="home-select-title" class="m-0 text-xl">어느 집인가요?</h2>
        <span class="rounded-full bg-white px-2.5 py-1 text-xs font-bold text-muted">약 10초</span>
      </div>

      <form id="quick-calc" class="grid gap-4" autocomplete="off">
        <label class="grid gap-1.5">
          <span class="text-sm font-bold">1. 동</span>
          <select id="f-building" aria-describedby="building-help"></select>
          <span id="building-help" class="text-xs text-muted">동을 고르면 AB22·AB23 블록은 자동으로 구분합니다.</span>
        </label>

        <label class="grid gap-1.5">
          <span class="text-sm font-bold">2. 층</span>
          <input id="f-floor" type="number" min="1" max="29" inputmode="numeric" value="10" />
        </label>

        <label class="grid gap-1.5">
          <span class="text-sm font-bold">3. 타입</span>
          <select id="f-type"></select>
        </label>

        <label id="line-field" class="hidden gap-1.5 rounded-xl border border-estimated/30 bg-estimated-soft p-3">
          <span class="text-sm font-bold">같은 조건에 가격이 두 개예요</span>
          <select id="f-line"></select>
          <span class="text-xs text-muted">6304동 84A 저층만 라인에 따라 금액이 달라 확인이 필요합니다.</span>
        </label>

        <p id="selection-note" class="m-0 rounded-xl bg-white px-3 py-2.5 text-sm text-muted" aria-live="polite"></p>

        <details class="group border-t border-line pt-4">
          <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-bold">
            계산 기준 바꾸기
            <span class="text-action group-open:rotate-45" aria-hidden="true">＋</span>
          </summary>
          <div class="mt-4 grid gap-4">
            <label class="grid gap-1.5">
              <span class="text-sm font-bold">계약일</span>
              <input id="f-contract-date" type="date" value="2026-07-20" />
            </label>
            <label class="grid gap-1.5">
              <span class="text-sm font-bold">중도금 대출 비율</span>
              <select id="f-loan-ratio">
                <option value="0.6">60% · 기본</option>
                <option value="0.5">50%</option>
                <option value="0.4">40%</option>
                <option value="0">대출 없음</option>
              </select>
            </label>
            <label class="grid gap-1.5">
              <span class="text-sm font-bold">예상 금리</span>
              <div class="relative"><input id="f-loan-rate" class="pr-10" type="number" min="0" max="20" step="0.1" value="4.5" /><span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-muted">%</span></div>
            </label>
            <label class="grid gap-1.5">
              <span class="text-sm font-bold">이자 납부 방식</span>
              <select id="f-loan-mode">
                <option value="이자후불제">이자후불제 · 입주 때 정산</option>
                <option value="이자자납">이자자납 · 공사 중 납부</option>
                <option value="무이자">무이자</option>
              </select>
            </label>
            <label id="balcony-field" class="check rounded-lg bg-white px-3 py-2">
              <input id="f-balcony" type="checkbox" checked />
              <span>발코니 확장비 포함</span>
            </label>
            <label class="grid gap-1.5">
              <span class="text-sm font-bold">그 밖의 유상옵션</span>
              <div class="relative"><input id="f-options" class="pr-10" type="number" min="0" step="100000" value="0" inputmode="numeric" /><span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-muted">원</span></div>
            </label>
            <label class="grid gap-1.5">
              <span class="text-sm font-bold">입주 준비 수준</span>
              <select id="f-interior">
                <option value="minimal">꼭 필요한 것만</option>
                <option value="standard" selected>보통 수준</option>
                <option value="premium">여유 있게</option>
              </select>
            </label>
          </div>
        </details>

        <button id="save-profile" type="button" class="mt-1 rounded-xl bg-ink px-4 py-3 text-sm font-bold text-white hover:bg-black">이 선택 기억하기</button>
        <p id="save-note" class="m-0 hidden text-center text-xs font-semibold text-confirmed">이 기기에 저장했습니다.</p>
      </form>
    </section>

    <section id="result" aria-live="polite">
      <div id="result-empty" class="rounded-2xl border border-line p-8 text-center text-muted">집 정보를 고르면 바로 계산합니다.</div>
      <div id="result-content" class="hidden">
        <div class="border-b-2 border-ink pb-7">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class="badge conf">공고 가격표 조회</span>
            <span id="r-selection" class="text-sm font-bold text-muted"></span>
          </div>
          <p class="mb-1 text-sm font-bold text-muted">입주까지 계획할 금액</p>
          <p id="r-plan-total" class="num m-0 text-[clamp(2rem,8vw,3.4rem)] font-[850] leading-tight tracking-[-.055em]"></p>
          <p class="mb-0 mt-3 text-sm leading-6 text-muted">공고 금액에 세금·대출이자·기본 입주 준비비를 더한 예상 범위입니다.</p>
        </div>

        <div class="grid border-b border-line py-6 sm:grid-cols-2">
          <article class="pb-5 sm:border-r sm:border-line sm:pb-0 sm:pr-6">
            <p class="m-0 text-sm font-bold text-muted">공식 분양가</p>
            <p id="r-price" class="num my-1 text-2xl font-extrabold"></p>
            <p id="r-price-note" class="m-0 text-xs leading-5 text-muted"></p>
          </article>
          <article class="border-t border-line pt-5 sm:border-t-0 sm:pl-6 sm:pt-0">
            <p class="m-0 text-sm font-bold text-muted">세금·이자·입주 준비비</p>
            <p id="r-extra" class="num my-1 text-2xl font-extrabold"></p>
            <p class="m-0 text-xs leading-5 text-muted">개인 조건과 2029년 시세에 따라 달라지는 추정치입니다.</p>
          </article>
        </div>

        <section class="py-7" aria-labelledby="cash-title">
          <SectionHeader title="언제 얼마가 필요할까요?" eyebrow="현금 계획" />
          <div class="mt-4 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-3">
            <article class="bg-white p-4"><p class="m-0 text-xs font-bold text-muted">입주 전까지</p><p id="r-before" class="num my-1 text-lg font-extrabold"></p><p class="m-0 text-xs text-muted">계약금·대출 외 중도금</p></article>
            <article class="bg-white p-4"><p class="m-0 text-xs font-bold text-muted">입주하는 날</p><p id="r-at" class="num my-1 text-lg font-extrabold"></p><p class="m-0 text-xs text-muted">잔금·세금·등기·이자</p></article>
            <article class="bg-white p-4"><p class="m-0 text-xs font-bold text-muted">입주 후</p><p id="r-after" class="num my-1 text-lg font-extrabold"></p><p class="m-0 text-xs text-muted">인테리어·이사·가전</p></article>
          </div>
          <p class="mt-3 rounded-xl bg-action-soft px-4 py-3 text-sm leading-6 text-ink">중도금 대출 <strong id="r-loan" class="num"></strong>은 입주 때 상환하거나 주택담보대출로 바꿔야 합니다.</p>
        </section>

        <section class="border-t border-line py-7" aria-labelledby="schedule-title">
          <div class="flex items-end justify-between gap-4">
            <SectionHeader title="납부 일정" eyebrow="공고 기준" />
            <a class="mb-1 text-sm font-bold text-action no-underline" href="/move-in">입주 준비로 이동</a>
          </div>
          <div class="scroll-x mt-3">
            <table>
              <thead><tr><th>날짜</th><th>납부 항목</th><th class="text-right">내 돈</th></tr></thead>
              <tbody id="r-schedule"></tbody>
            </table>
          </div>
        </section>

        <details class="border-y border-line py-5">
          <summary class="cursor-pointer text-sm font-bold">이 계산의 기준과 주의사항</summary>
          <ul class="mb-0 mt-4 grid gap-2 pl-5 text-sm leading-6 text-muted">
            <li>공급금액은 2026년 6월 12일 입주자모집공고 가격표를 조회했습니다.</li>
            <li>계약일 2026년 7월 20일, 중도금 대출 60%, 금리 연 4.5%, 이자후불제를 기본값으로 사용합니다.</li>
            <li>발코니·유상옵션과 실제 대출 조건은 계약서 및 금융기관 안내가 우선합니다.</li>
            <li>저층과 21층 이상은 실제 세대 존재 여부를 계약서에서 다시 확인해야 합니다.</li>
          </ul>
        </details>
      </div>
    </section>
  </div>

  <script>
    import '../scripts/calculator';
  </script>
</Base>
