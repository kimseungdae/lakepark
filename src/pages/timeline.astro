---
import Base from '../layouts/Base.astro';
import StatusPill from '../components/StatusPill.astro';
import { CURATED_MILESTONES } from '../data/timeline/milestones';
import { GEOMDAN_LAKEPARK, PAYMENT_STRUCTURE } from '../data/presets/geomdan-lakepark';
import { buildMoveInTimeline } from '../lib/timeline';
import { formatDate } from '../lib/format';

const timeline = buildMoveInTimeline({
  interimDates: PAYMENT_STRUCTURE.interim.dates,
  interimRatioEach: PAYMENT_STRUCTURE.interim.ratioEach,
  balanceRatio: PAYMENT_STRUCTURE.balanceRatio,
  moveInDate: GEOMDAN_LAKEPARK.expectedMoveInDate,
  milestones: CURATED_MILESTONES,
});
const kindLabels: Record<string, string> = { payment: '납부', inspection: '점검', admin: '준비', moveIn: '입주' };
const displayDate = (date: string, precision: string): string => precision === 'day' ? formatDate(date) : `${date.slice(0, 4)}년 ${Number(date.slice(5, 7))}월 전후`;
---

<Base title="입주 일정" description="공고 납부일과 입주 전후 준비 일정을 확인합니다.">
  <header class="mb-8 max-w-3xl"><p class="mb-3 text-sm font-bold text-action">입주 일정</p><h1 class="mb-4">납부일부터 입주일까지</h1><p class="m-0 text-lg leading-7 text-muted">공고의 중도금 날짜와 예정 입주월을 구분해 표시합니다.</p></header>
  <a class="mb-10 flex items-center justify-between rounded-2xl bg-action-soft p-5 no-underline" href="/move-in"><span><strong class="block text-lg">내 일정으로 바꾸고 캘린더 받기</strong><span class="mt-1 block text-sm text-muted">입주 준비 작업대에서 사전방문·선택 입주일과 할 일을 저장하세요.</span></span><span class="text-xl text-action">→</span></a>
  <ol class="relative m-0 max-w-3xl list-none border-l-2 border-line p-0">
    {timeline.map((entry) => <li class="relative pb-8 pl-7 before:absolute before:-left-[7px] before:top-2 before:h-3 before:w-3 before:rounded-full before:bg-action">
      <div class="mb-2 flex flex-wrap items-center gap-2"><span class="num text-sm font-bold text-muted">{displayDate(entry.date, entry.datePrecision)}</span><StatusPill label={entry.confidence === 'confirmed' ? '공고 날짜' : '예정'} tone={entry.confidence === 'confirmed' ? 'green' : 'orange'} /></div>
      <h2 class="m-0 text-lg"><span class="mr-2 text-xs font-bold text-action">{kindLabels[entry.kind]}</span>{entry.title}</h2>
      {entry.note && <p class="mb-0 mt-1 text-sm leading-6 text-muted">{entry.note}</p>}
    </li>)}
  </ol>
</Base>
