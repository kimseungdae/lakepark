---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatusPill from '../components/StatusPill.astro';
import { STATUS_BOARD } from '../data/status/board';
import { formatDate } from '../lib/format';
import { toEditorialUpdate, type EditorialStatus } from '../lib/editorial';

const categories = [
  { key: 'transport', label: '교통' },
  { key: 'development', label: '개발' },
  { key: 'park', label: '공원·수변' },
  { key: 'culture', label: '문화' },
  { key: 'education', label: '교육' },
  { key: 'admin', label: '행정' },
] as const;
const statusMeta: Record<EditorialStatus, { label: string; tone: 'green' | 'blue' | 'orange' | 'gray' }> = {
  operating: { label: '운영 중', tone: 'green' },
  inProgress: { label: '추진 중', tone: 'blue' },
  planned: { label: '계획', tone: 'orange' },
  recheck: { label: '확인 필요', tone: 'gray' },
};
const groups = categories.map((category) => ({
  ...category,
  updates: STATUS_BOARD.filter((item) => item.category === category.key).map(toEditorialUpdate),
})).filter((group) => group.updates.length > 0);
---

<Base title="단지 소식" description="검단 교통·학교·공원·개발 소식을 운영 중, 추진 중, 계획으로 나눠 원문과 함께 정리합니다.">
  <header class="mb-8 max-w-3xl">
    <p class="mb-3 text-sm font-bold text-action">단지 소식</p>
    <h1 class="mb-4">호재 대신,<br />지금 어디까지 왔는지</h1>
    <p class="m-0 text-[1.05rem] leading-7 text-muted">예타 통과는 개통이 아니고, 입찰공고는 착공이 아닙니다. 공식 발표를 생활에 필요한 말로 번역하고 다음 확인할 지점을 함께 적습니다.</p>
  </header>

  <div class="mb-10 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-4">
    <div class="bg-white p-4"><StatusPill label="운영 중" tone="green" /><p class="mb-0 mt-2 text-xs text-muted">현재 실제 이용 가능</p></div>
    <div class="bg-white p-4"><StatusPill label="추진 중" tone="blue" /><p class="mb-0 mt-2 text-xs text-muted">행정·계약·공사가 진행</p></div>
    <div class="bg-white p-4"><StatusPill label="계획" tone="orange" /><p class="mb-0 mt-2 text-xs text-muted">발표됐지만 실행 전</p></div>
    <div class="bg-white p-4"><StatusPill label="확인 필요" tone="gray" /><p class="mb-0 mt-2 text-xs text-muted">미래 시점에 다시 확인</p></div>
  </div>

  <nav class="-mx-[1.125rem] mb-12 flex gap-5 overflow-x-auto border-y border-line px-[1.125rem] py-3 text-sm font-bold [scrollbar-width:none]" aria-label="소식 분류">
    {groups.map((group) => <a class="shrink-0 no-underline hover:text-action" href={`#category-${group.key}`}>{group.label} <span class="text-muted">{group.updates.length}</span></a>)}
  </nav>

  <div class="grid gap-14">
    {groups.map((group) => (
      <section id={`category-${group.key}`} class="scroll-mt-32">
        <SectionHeader title={group.label} description={`${group.updates.length}개 항목을 추적하고 있습니다.`} />
        <div class="divide-y divide-line border-b border-line">
          {group.updates.map((update) => {
            const meta = statusMeta[update.status];
            return (
              <article id={update.id} class="scroll-mt-32 py-7">
                <div class="mb-3 flex flex-wrap items-center gap-2"><StatusPill label={meta.label} tone={meta.tone} /><time class="text-xs font-semibold text-muted" datetime={update.checkedAt}>{formatDate(update.checkedAt)} 확인</time></div>
                <h2 class="m-0 text-[1.45rem] sm:text-[1.7rem]">{update.headline}</h2>
                <p class="mb-4 mt-2 max-w-4xl text-base leading-7 text-muted">{update.dek}</p>
                <dl class="grid gap-3 rounded-xl bg-canvas p-4 text-sm leading-6 sm:grid-cols-3">
                  <div><dt class="font-extrabold text-ink">무엇이 바뀌었나</dt><dd class="m-0 mt-1 text-muted">{update.whatChanged}</dd></div>
                  <div><dt class="font-extrabold text-ink">지금 의미</dt><dd class="m-0 mt-1 text-muted">{update.currentMeaning}</dd></div>
                  <div><dt class="font-extrabold text-ink">다음에 볼 것</dt><dd class="m-0 mt-1 text-muted">{update.nextCheck}</dd></div>
                </dl>
                <details class="mt-3">
                  <summary class="cursor-pointer text-xs font-bold text-action">공식 근거 {update.sources.length}개 보기</summary>
                  <ul class="mb-0 mt-2 grid gap-1 pl-5 text-xs leading-5 text-muted">
                    {update.sources.map((source) => <li><a class="underline underline-offset-2 hover:text-action" href={source.url} target="_blank" rel="noreferrer">{source.label}</a> · {source.asOf}</li>)}
                  </ul>
                </details>
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Base>
