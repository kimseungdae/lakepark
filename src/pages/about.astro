---
import Base from '../layouts/Base.astro';
import { GEOMDAN_LAKEPARK } from '../data/presets/geomdan-lakepark';
import { ACQUISITION_TAX, ANCILLARY_COSTS, INTERIM_LOAN, MOVE_IN_COSTS } from '../data/rates';
import { SITE } from '../data/site';

const sources = [
  { name: '분양가·납부일정·옵션', ...GEOMDAN_LAKEPARK.source },
  { name: '취득세', ...ACQUISITION_TAX.source },
  { name: '중도금 대출 이자', ...INTERIM_LOAN.source },
  { name: '입주 준비비', ...MOVE_IN_COSTS.source },
  { name: '등기·법무 비용', ...ANCILLARY_COSTS.source },
];
---

<Base title="운영 안내" description={`${SITE.name}의 운영 주체, 근거, 한계를 밝힙니다.`}>
  <header class="mb-10 max-w-3xl"><p class="mb-3 text-sm font-bold text-action">운영 안내</p><h1 class="mb-4">누가, 왜 만들었나요?</h1><p class="m-0 text-lg leading-7 text-muted">복잡한 공고와 입주 준비를 계약자가 실제 쓰는 말과 도구로 바꿉니다.</p></header>
  <div class="max-w-4xl text-[.98rem] leading-7">
    <section class="rounded-2xl bg-danger-soft p-6"><h2 class="mt-0 text-xl">시공사와 무관한 비공식 사이트입니다</h2><p class="mb-0 text-muted">개인이 만든 참고 도구이며 시공사·시행사·분양사·입주자대표회의와 아무런 관계가 없습니다. 단지명과 블록명은 대상을 특정하기 위한 데이터 값으로만 사용합니다.</p></section>

    <section class="mt-10"><h2>제공하는 것</h2><ul class="grid gap-2 pl-5 text-muted"><li>동·층·타입으로 공고 가격표를 조회하는 비용 계산</li><li>계약금·중도금·잔금과 입주 준비비의 시점별 현금 계획</li><li>납부계좌 대조, 권리 시계, 일정 캘린더</li><li>견적·치수·하자 기록을 위한 로컬 도구</li><li>교통·학교·공원·행정의 현재 단계와 공식 근거</li></ul></section>

    <section class="mt-10"><h2>계산 결과를 읽는 법</h2><p class="text-muted"><span class="badge conf">공고 가격</span>은 공식 가격표에서 조회한 금액입니다. <span class="badge est">계획용 예상</span>은 세금·이자·입주 준비비를 기본 가정으로 더한 범위입니다. 실제 공급계약서, 금융기관 조건, 입주 시점의 세법과 견적이 항상 우선합니다.</p></section>

    <section class="mt-10"><h2>계산 근거</h2><div class="scroll-x"><table><thead><tr><th>항목</th><th>근거</th><th>기준일</th></tr></thead><tbody>{sources.map((source) => <tr><td class="font-bold">{source.name}</td><td>{source.url ? <a class="underline underline-offset-2" href={source.url}>{source.label}</a> : source.label}</td><td class="num whitespace-nowrap">{source.asOf}</td></tr>)}</tbody></table></div></section>

    <section class="mt-10"><h2>하지 않는 것</h2><ul class="grid gap-2 pl-5 text-muted"><li>시세 전망, 투자 추천, 가격 상승 가능성을 판단하지 않습니다.</li><li>대출 승인·한도, 세액, 전매 가능일, 법정 하자 여부를 확정하지 않습니다.</li><li>특정 업체를 추천하거나 광고·제휴 순위를 만들지 않습니다.</li><li>시공사 저작물인 평면도·조감도를 재게시하지 않습니다.</li></ul></section>

    <section class="mt-10 border-t border-line pt-8"><h2>최종 확인</h2><p class="text-muted">금액과 날짜는 본인 공급계약서·변경계약서·공식 입주안내문을, 대출은 금융기관을, 세금은 위택스·세무 전문가를, 법률 문제는 최신 법령과 전문가를 기준으로 확인하세요.</p></section>
  </div>
</Base>
