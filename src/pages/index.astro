---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SubscribeCta from '../components/SubscribeCta.astro';
import { GEOMDAN_LAKEPARK } from '../data/presets/geomdan-lakepark';
import { STATUS_BOARD } from '../data/status/board';
import { SITE } from '../data/site';
import { formatDate } from '../lib/format';

const blocks = Object.entries(GEOMDAN_LAKEPARK.blocks) as Array<
  [keyof typeof GEOMDAN_LAKEPARK.blocks, (typeof GEOMDAN_LAKEPARK.blocks)[keyof typeof GEOMDAN_LAKEPARK.blocks]]
>;
const firstBlockTypes = blocks[0]?.[1].types ?? [];

// 최근 변경 3건은 빌드 시점 데이터만으로 정렬한다 (시계 불필요 → 정적 렌더 가능).
const latestChanges = STATUS_BOARD.flatMap((item) =>
  item.history.map((change) => ({ item, change })),
)
  .sort((a, b) => b.change.date.localeCompare(a.change.date))
  .slice(0, 3);
---

<Base title={SITE.name} description={SITE.tagline}>
  <h1>입주까지, 필요한 것만 요약해서</h1>
  <p class="lede">
    검단레이크파크 AB22·AB23 예비입주민을 위한 비공식 정보 노트입니다.
    블록·타입을 한 번 선택하면 내 일정과 정보를 먼저 보여드립니다.
  </p>

  <Hero
    image="hero-lake.jpg"
    alt="호수와 공원, 아파트 단지가 어우러진 노을 풍경"
  />

  <section id="p-setup" class="card">
    <h2 class="card-title">내 세대 선택</h2>
    <p class="hint">
      선택은 이 브라우저에만 저장되며 어디로도 전송되지 않습니다.
      동·호수는 묻지 않습니다.
    </p>
    <div class="setup-row">
      <label class="field">
        <span class="label">블록</span>
        <select id="p-block">
          {blocks.map(([key, block]) => <option value={key}>{block.name}</option>)}
        </select>
      </label>
      <label class="field">
        <span class="label">타입</span>
        <select id="p-type">
          {firstBlockTypes.map((t) => <option value={t.code}>{t.code}</option>)}
        </select>
      </label>
      <button type="button" id="p-save" class="save-btn">저장</button>
    </div>
  </section>

  <section id="p-summary" hidden aria-live="polite">
    <div class="summary-head">
      <p class="summary-unit">내 세대 <strong id="p-unit-label"></strong></p>
      <div class="summary-actions">
        <button type="button" id="p-change" class="chip">변경</button>
        <button type="button" id="p-clear" class="chip">초기화</button>
      </div>
    </div>

    <div class="card next-card">
      <p class="card-title">다음 납부</p>
      <p id="p-next-payment" class="next-body">—</p>
      <p id="p-next-amount" class="hint"></p>
    </div>

    <div class="my-links">
      <a id="p-guide-link" class="card module" href="/guide">
        <p class="module-title">🏢 내 타입 구조·옵션 읽기</p>
        <p class="module-desc">공고에서 확인된 특징과 생활 해석</p>
      </a>
      <a class="card module" href="/calculator">
        <p class="module-title">🧮 내 조건으로 총비용 계산</p>
        <p class="module-desc">계약금부터 입주까지 시점별 현금</p>
      </a>
    </div>
  </section>

  <h2>최근 상태판 변경</h2>
  <ul class="changes">
    {
      latestChanges.map(({ item, change }) => (
        <li>
          <span class="change-date">{formatDate(change.date)}</span>
          <a href={`/status#${item.id}`}>{item.title}</a>
          <span class="change-summary">{change.summary}</span>
        </li>
      ))
    }
  </ul>
  <p class="hint"><a href="/status">전체 상태판 보기 →</a></p>

  <nav class="modules" aria-label="주요 기능">
    <a class="module card" href="/timeline">
      <p class="module-title">📅 입주까지 일정</p>
      <p class="module-desc">중도금 6회차와 입주예정일까지, 오늘 기준 남은 일정.</p>
    </a>
    <a class="module card" href="/status">
      <p class="module-title">🚧 개발계획 상태판</p>
      <p class="module-desc">5호선·학교·공원이 지금 어느 단계인지, 근거·확인일과 함께.</p>
    </a>
    <a class="module card" href="/guide">
      <p class="module-title">🏢 타입·동 가이드</p>
      <p class="module-desc">59A~84C 구조 비교와 동별 생활영향 요약.</p>
    </a>
    <a class="module card" href="/calculator">
      <p class="module-title">🧮 총비용 계산기</p>
      <p class="module-desc">계약금부터 입주까지, 시점별로 실제 필요한 현금 계산.</p>
    </a>
  </nav>

  <SubscribeCta context="home" />

  <script>
    import '../scripts/home';
  </script>

  <style>
    .lede {
      font-size: 1.05rem;
      color: var(--text-muted);
      margin: 0 0 1.5rem;
    }
    .setup-row {
      display: grid;
      grid-template-columns: 1fr 1fr auto;
      gap: 0.6rem;
      align-items: end;
    }
    .field {
      display: block;
      margin: 0;
    }
    .label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 0.3rem;
    }
    .save-btn {
      font: inherit;
      font-weight: 600;
      padding: 0.5rem 1.1rem;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    }
    .summary-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 0.6rem;
    }
    .summary-unit {
      margin: 0;
      font-size: 0.95rem;
    }
    .summary-actions {
      display: flex;
      gap: 0.4rem;
    }
    .next-card {
      border-left: 3px solid var(--accent);
    }
    .next-body {
      margin: 0;
      font-size: 1.05rem;
    }
    :global(.next-body .dday-big) {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--accent);
      font-variant-numeric: tabular-nums;
    }
    .my-links {
      display: grid;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }
    @media (min-width: 40rem) {
      .my-links {
        grid-template-columns: 1fr 1fr;
      }
    }
    .changes {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .changes li {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      flex-wrap: wrap;
      padding: 0.55rem 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.94rem;
    }
    .changes li:last-child {
      border-bottom: none;
    }
    .change-date {
      font-variant-numeric: tabular-nums;
      color: var(--text-muted);
      font-size: 0.84rem;
      white-space: nowrap;
    }
    .change-summary {
      flex: 1 1 14rem;
      color: var(--text-muted);
      font-size: 0.88rem;
    }
    .modules {
      display: grid;
      gap: 0.75rem;
      margin: 1.5rem 0;
    }
    @media (min-width: 40rem) {
      .modules {
        grid-template-columns: 1fr 1fr;
      }
    }
    .module {
      display: block;
      text-decoration: none;
      color: var(--text);
      margin: 0;
    }
    .module:hover {
      border-color: var(--accent);
    }
    .module-title {
      font-weight: 700;
      margin: 0 0 0.3rem;
    }
    .module-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin: 0;
    }
  </style>
</Base>
