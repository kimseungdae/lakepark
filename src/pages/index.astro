---
import Base from '../layouts/Base.astro';
import NewsRow from '../components/NewsRow.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatusPill from '../components/StatusPill.astro';
import { STATUS_BOARD } from '../data/status/board';
import { SITE } from '../data/site';
import { toEditorialUpdate, type EditorialStatus } from '../lib/editorial';

const updates = STATUS_BOARD.map(toEditorialUpdate);
const lead = updates.find((item) => item.id === 'seoul-line5-extension')!;
const recent = [...updates]
  .sort((a, b) => (b.changedAt ?? b.checkedAt).localeCompare(a.changedAt ?? a.checkedAt))
  .slice(0, 5);
const statusLabels: Record<EditorialStatus, string> = {
  operating: '운영 중',
  inProgress: '추진 중',
  planned: '계획',
  recheck: '확인 필요',
};
const categoryLabels: Record<string, string> = {
  transport: '교통', development: '개발', park: '공원', culture: '문화', education: '교육', admin: '행정',
};
---

<Base title={SITE.name} description={SITE.tagline}>
  <section class="grid gap-7 border-b-2 border-ink pb-9 lg:grid-cols-[minmax(0,1.45fr)_minmax(280px,.55fr)] lg:items-end">
    <article>
      <div class="mb-4 flex items-center gap-2"><StatusPill label="추진 중" tone="blue" /><span class="text-xs font-bold text-muted">교통 · 2026.08.11 확인</span></div>
      <h1 class="mb-4 max-w-3xl text-[clamp(2.15rem,6vw,4.4rem)]">서울5호선 검단 연장,<br />예타 다음 단계는 무엇일까</h1>
      <p class="m-0 max-w-3xl text-[1.05rem] leading-7 text-muted">{lead.dek} 예타 통과는 개통이나 역 위치 확정이 아닙니다. 다음 공식 절차가 움직였는지 계속 확인합니다.</p>
      <a class="mt-6 inline-flex items-center rounded-lg bg-ink px-5 py-3 text-sm font-bold text-white no-underline hover:bg-black" href={`/status#${lead.id}`}>근거와 다음 확인 보기</a>
    </article>
    <aside class="rounded-2xl bg-action-soft p-6">
      <p class="m-0 text-xs font-extrabold text-action">10초 비용 조회</p>
      <h2 class="mb-2 mt-2 text-2xl">우리 집 분양가부터<br />입주 자금까지</h2>
      <p class="m-0 text-sm leading-6 text-muted">동·층·타입을 고르면 공고 가격표를 찾아 자동 계산합니다.</p>
      <a class="mt-5 flex min-h-12 items-center justify-center rounded-xl bg-action px-4 font-bold text-white no-underline" href="/calculator">우리 집 비용 계산하기</a>
    </aside>
  </section>

  <section class="grid gap-10 py-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(280px,.65fr)]">
    <div>
      <SectionHeader title="최근 단지 소식" description="변경일과 공식 근거를 함께 확인했습니다." href="/status" />
      <div>
        {recent.map((item) => <NewsRow href={`/status#${item.id}`} category={categoryLabels[item.category] ?? item.category} title={item.headline} date={item.changedAt ?? item.checkedAt} status={statusLabels[item.status]} />)}
      </div>
    </div>

    <aside>
      <SectionHeader title="입주 준비 바로가기" description="기록은 이 기기에만 저장됩니다." />
      <div class="divide-y divide-line border-y border-line">
        <a class="group block py-5 no-underline" href="/move-in#section-1"><span class="text-xs font-bold text-action">일정</span><strong class="mt-1 block text-lg group-hover:text-action">납부일 캘린더와 할 일</strong><span class="mt-1 block text-sm text-muted">중도금 6회와 내 입주일을 한곳에</span></a>
        <a class="group block py-5 no-underline" href="/move-in#section-2"><span class="text-xs font-bold text-danger">송금 전</span><strong class="mt-1 block text-lg group-hover:text-action">공식 계좌 5단계 대조</strong><span class="mt-1 block text-sm text-muted">블록·항목·예금주·원문·계약서 확인</span></a>
        <a class="group block py-5 no-underline" href="/move-in#section-6"><span class="text-xs font-bold text-confirmed">사전점검</span><strong class="mt-1 block text-lg group-hover:text-action">하자 기록과 사진 보관</strong><span class="mt-1 block text-sm text-muted">접수부터 재점검까지 상태 관리</span></a>
      </div>
    </aside>
  </section>

  <section class="border-t border-line pt-10">
    <SectionHeader title="생활에 바로 쓰는 정보" description="홍보 문구보다 실제 확인할 행동을 먼저 정리했습니다." />
    <div class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3">
      <a class="group bg-white p-6 no-underline" href="/guide#types"><span class="text-xs font-bold text-muted">타입 비교</span><h3 class="mb-2 mt-2 text-xl group-hover:text-action">59A부터 84C까지<br />선택 차이 읽기</h3><p class="m-0 text-sm leading-6 text-muted">면적·공고 금액·유상옵션 핵심을 한눈에</p></a>
      <a class="group bg-white p-6 no-underline" href="/guide#buildings"><span class="text-xs font-bold text-muted">우리 동</span><h3 class="mb-2 mt-2 text-xl group-hover:text-action">차량·쓰레기·기계실<br />생활 영향 확인</h3><p class="m-0 text-sm leading-6 text-muted">공고에 직접 적힌 동별 유의사항</p></a>
      <a class="group bg-white p-6 no-underline" href="/status#incheon-line1-geomdan"><span class="text-xs font-bold text-muted">출퇴근</span><h3 class="mb-2 mt-2 text-xl group-hover:text-action">검단호수공원역<br />운영 정보 보기</h3><p class="m-0 text-sm leading-6 text-muted">개통 사실과 현장 재확인 포인트 분리</p></a>
    </div>
  </section>

  <p class="mt-10 border-t border-line pt-6 text-xs leading-5 text-muted">이 사이트는 시공사·시행사와 무관한 비공식 입주 가이드입니다. 시세 전망이나 투자 판단이 아니라 공식 공고, 생활 정보, 입주 준비 도구를 제공합니다.</p>
</Base>
