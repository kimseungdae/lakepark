---
import Base from '../layouts/Base.astro';
import { GEOMDAN_LAKEPARK, PAYMENT_STRUCTURE } from '../data/presets/geomdan-lakepark';
import { SITE } from '../data/site';
import { formatDate } from '../lib/format';

const preset = GEOMDAN_LAKEPARK;
const blocks = Object.entries(preset.blocks) as Array<
  [keyof typeof preset.blocks, (typeof preset.blocks)[keyof typeof preset.blocks]]
>;
---

<Base title={SITE.name} description={SITE.tagline}>
  <h1>분양가만 보면 자금계획이 틀어집니다</h1>
  <p class="lede">
    계약금·중도금·잔금에 취득세, 등기비, 옵션 잔금, 인테리어까지 더해
    <strong>언제 얼마의 현금이 필요한지</strong>를 시점별로 계산합니다.
  </p>

  <p class="notice">
    <strong>{preset.displayName}</strong> 프리셋이 기본 탑재되어 있습니다. 금액은
    {preset.source.label} 기준이며, {preset.source.asOf}에 확인했습니다.
    <a href="/about">이 계산기는 비공식 개인 도구입니다.</a>
  </p>

  <form id="calc" autocomplete="off">
    <section class="card">
      <h2 class="card-title">1. 세대 선택</h2>
      <div class="grid-2">
        <label class="field">
          <span class="label">블록</span>
          <select id="f-block">
            {blocks.map(([key, block]) => <option value={key}>{block.name}</option>)}
          </select>
        </label>
        <label class="field">
          <span class="label">타입</span>
          <select id="f-type"></select>
        </label>
      </div>

      <div class="field">
        <span class="label">공급금액 (분양가)</span>
        <div id="f-price-quick" class="chips"></div>
        <input id="f-price" type="number" step="100000" inputmode="numeric" />
        <p id="f-price-hint" class="hint"></p>
      </div>

      <label class="field">
        <span class="label">계약일</span>
        <input id="f-contract-date" type="date" value="2026-07-20" />
        <p class="hint">
          계약금 2차 기한(계약 후 {PAYMENT_STRUCTURE.downPayment.secondInstallmentOffsetDays}일 이내)이
          여기서 계산됩니다.
        </p>
      </label>
    </section>

    <section class="card">
      <h2 class="card-title">2. 발코니 확장 · 유상옵션</h2>
      <p class="hint">
        옵션은 분양대금과 <strong>별도 트랙</strong>입니다. 계약 시
        {PAYMENT_STRUCTURE.optionDownPaymentRatio * 100}%, 입주지정일에 나머지를 냅니다.
      </p>

      <label class="check">
        <input id="f-balcony" type="checkbox" checked />
        <span>발코니 확장 (일괄확장, 실별 선택 불가)</span>
        <span id="f-balcony-amount" class="num muted"></span>
      </label>

      <div id="f-options" class="options"></div>

      <p class="hint">
        같은 품목의 등급(예: 시스템에어컨 기본형·전실형)은 하나만 선택해야 합니다.
        이 목록은 선택한 금액을 그대로 합산할 뿐 배타 조건을 검사하지 않습니다.
      </p>

      <p class="options-total">선택한 옵션 합계 <strong id="f-options-total">0원</strong></p>
    </section>

    <section class="card">
      <h2 class="card-title">3. 중도금 대출</h2>
      <p class="warn-inline">
        사업주체는 대출 알선·승인·한도·금리를 보장하지 않습니다. 대출이 실행되지 않으면
        해당 금액을 전액 자기자금으로 조달해야 합니다.
      </p>
      <div class="grid-3">
        <label class="field">
          <span class="label">대출 비율 (분양가 대비 %)</span>
          <input id="f-loan-ratio" type="number" min="0" max="100" step="5" value="60" />
        </label>
        <label class="field">
          <span class="label">이자 방식</span>
          <select id="f-loan-mode">
            <option value="이자후불제">이자후불제 (입주 시 정산)</option>
            <option value="이자자납">이자자납 (공사 중 납부)</option>
            <option value="무이자">무이자 (시행사 부담)</option>
          </select>
        </label>
        <div id="f-loan-rate-row" class="field">
          <label class="label" for="f-loan-rate">연이율 (%)</label>
          <input id="f-loan-rate" type="number" min="0" max="15" step="0.1" value="4.5" />
        </div>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">4. 입주 준비 비용</h2>
      <div class="grid-2">
        <label class="field">
          <span class="label">인테리어 수준</span>
          <select id="f-interior">
            <option value="minimal">최소 — 도배·조명 위주</option>
            <option value="standard" selected>표준 — 중문·줄눈·탄성코트 포함</option>
            <option value="premium">고급 — 주방·욕실 부분 리모델링</option>
          </select>
        </label>
        <div class="field">
          <span class="label">계상 옵션</span>
          <label class="check">
            <input id="f-appliances" type="checkbox" checked />
            <span>가전 구입비 포함</span>
          </label>
          <label class="check">
            <input id="f-options-tax" type="checkbox" checked />
            <span>옵션을 취득세 과세표준에 포함</span>
          </label>
          <p class="hint">
            옵션의 과세표준 포함 범위는 세무 확인 대상입니다. 위택스·세무 전문가에게 확인하세요.
          </p>
        </div>
      </div>
    </section>
  </form>

  <h2>언제 얼마가 필요한가</h2>
  <div class="phases">
    <div class="phase">
      <p class="phase-label">입주 전까지</p>
      <p class="phase-amount" id="r-phase-before">—</p>
      <p class="phase-note">계약금 + 중도금 자기부담 + 옵션 계약금</p>
    </div>
    <div class="phase">
      <p class="phase-label">입주지정일 ({formatDate(preset.expectedMoveInDate)} 예정)</p>
      <p class="phase-amount" id="r-phase-at">—</p>
      <p class="phase-note">잔금 + 옵션 잔금 + 취득세 + 등기비</p>
    </div>
    <div class="phase">
      <p class="phase-label">입주 후 <span class="badge est">추정</span></p>
      <p class="phase-amount" id="r-phase-after">—</p>
      <p class="phase-note">인테리어 + 청소 + 이사 + 가전</p>
    </div>
  </div>

  <p class="carried">
    이와 별개로 <strong id="r-carried-loan">—</strong>의 중도금 대출 잔액을 입주 시점에
    <strong>상환하거나 주택담보대출로 전환</strong>해야 합니다. 2029년의 DSR·LTV 규정과
    담보평가액은 지금 확정할 수 없습니다.
  </p>

  <h2>확정 금액과 추정 금액</h2>
  <div class="grid-2">
    <div class="card sum confirmed">
      <p class="sum-label"><span class="badge conf">공고 확정</span></p>
      <p class="sum-amount" id="r-confirmed-total">—</p>
      <p class="sum-detail" id="r-confirmed-detail"></p>
      <p class="hint">입주자모집공고와 공급계약서에 적힌 금액입니다.</p>
    </div>
    <div class="card sum estimated">
      <p class="sum-label"><span class="badge est">추정</span></p>
      <p class="sum-amount" id="r-estimated-total">—</p>
      <table class="mini">
        <tbody id="r-estimated-rows"></tbody>
      </table>
      <p class="hint">
        개인 조건·시장에 따라 달라집니다. 확정 금액과 더한 단일 "총 입주비용"은
        의도적으로 제공하지 않습니다.
      </p>
    </div>
  </div>

  <h2>납부 타임라인</h2>
  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>납부일</th>
          <th>구분</th>
          <th class="num">금액</th>
          <th class="num">대출</th>
          <th class="num">자기부담</th>
        </tr>
      </thead>
      <tbody id="r-timeline"></tbody>
    </table>
  </div>

  <details class="basis">
    <summary>산출 근거 보기</summary>
    <div id="r-basis" class="prose"></div>
  </details>

  {
    SITE.stibeeFormAction && (
      <section class="card subscribe">
        <h2 class="card-title">입주 준비 알림 받기</h2>
        <p class="hint">
          중도금 회차, 입주지정일 확정, 사전점검 일정처럼 놓치기 쉬운 시점을 메일로 알려드립니다.
        </p>
        <form action={SITE.stibeeFormAction} method="post" target="_blank" id="subscribe-form">
          <div class="subscribe-row">
            <input type="email" name="email" required placeholder="이메일 주소" aria-label="이메일 주소" />
            <button type="submit">알림 신청</button>
          </div>
          <label class="check">
            <input type="checkbox" name="agree_email" value="Y" required />
            <span>이메일 수신에 동의합니다. 언제든 수신거부할 수 있습니다.</span>
          </label>
        </form>
        <p class="hint">
          구독 정보는 스티비에 위탁 보관되며 이 사이트 서버에는 저장되지 않습니다.
          자세한 내용은 <a href="/privacy">개인정보 처리방침</a>을 확인하세요.
        </p>
      </section>
    )
  }

  <script>
    import '../scripts/calculator';
  </script>

  <style>
    .lede {
      font-size: 1.05rem;
      color: var(--text-muted);
      margin: 0 0 1.25rem;
    }
    .notice {
      background: var(--accent-soft);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.75rem 0.9rem;
      font-size: 0.87rem;
      margin: 0 0 1.5rem;
    }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem 1.1rem 1.2rem;
      margin: 0 0 1rem;
    }
    .card-title {
      font-size: 0.95rem;
      margin: 0 0 0.75rem;
      color: var(--text-muted);
      font-weight: 600;
    }
    .grid-2,
    .grid-3 {
      display: grid;
      gap: 0.9rem;
    }
    @media (min-width: 40rem) {
      .grid-2 {
        grid-template-columns: 1fr 1fr;
      }
      .grid-3 {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .field {
      display: block;
      margin: 0 0 0.9rem;
    }
    .field:last-child {
      margin-bottom: 0;
    }
    .label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 0.3rem;
    }
    input[type='number'],
    input[type='date'],
    input[type='email'],
    select {
      width: 100%;
      padding: 0.5rem 0.6rem;
      font: inherit;
      font-variant-numeric: tabular-nums;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    input:focus-visible,
    select:focus-visible,
    button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }
    .options {
      margin-top: 0.5rem;
      border-top: 1px solid var(--border);
      padding-top: 0.4rem;
    }
    .options-total {
      margin: 0.75rem 0 0;
      padding-top: 0.6rem;
      border-top: 1px solid var(--border);
      font-size: 0.87rem;
      display: flex;
      justify-content: space-between;
      font-variant-numeric: tabular-nums;
    }
    .warn-inline {
      background: var(--warn-soft);
      color: var(--warn);
      border-radius: 8px;
      padding: 0.55rem 0.7rem;
      font-size: 0.8rem;
      margin: 0 0 0.9rem;
    }
    .phases {
      display: grid;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }
    @media (min-width: 46rem) {
      .phases {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .phase {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.9rem 1rem;
    }
    .phase-label {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin: 0 0 0.3rem;
    }
    .phase-amount {
      font-size: 1.3rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      margin: 0 0 0.3rem;
      letter-spacing: -0.02em;
    }
    .phase-note {
      font-size: 0.76rem;
      color: var(--text-muted);
      margin: 0;
    }
    .carried {
      background: var(--warn-soft);
      color: var(--warn);
      border-radius: var(--radius);
      padding: 0.75rem 0.9rem;
      font-size: 0.85rem;
      margin: 0 0 1rem;
    }
    .sum {
      margin-bottom: 0;
    }
    .sum-label {
      margin: 0 0 0.4rem;
    }
    .sum-amount {
      font-size: 1.45rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      margin: 0 0 0.3rem;
      letter-spacing: -0.02em;
    }
    .sum-detail {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin: 0 0 0.5rem;
    }
    .confirmed {
      border-left: 3px solid var(--confirmed);
    }
    .estimated {
      border-left: 3px solid var(--estimated);
    }
    :global(#r-timeline .tag) {
      font-size: 0.68rem;
      color: var(--text-muted);
      margin-left: 0.4rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0 0.35rem;
    }
    :global(#r-timeline .is-option) {
      color: var(--text-muted);
    }
    :global(#r-timeline .strong) {
      font-weight: 600;
    }
    .basis {
      margin: 1.5rem 0;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.75rem 1rem;
    }
    .basis summary {
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 600;
    }
    :global(#r-basis h4) {
      font-size: 0.88rem;
      margin: 1rem 0 0.35rem;
    }
    :global(#r-basis ul) {
      margin: 0;
      font-size: 0.83rem;
    }
    :global(#r-basis code) {
      background: var(--surface-2);
      padding: 0.05rem 0.3rem;
      border-radius: 4px;
      font-size: 0.9em;
    }
    .subscribe-row {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 0.4rem;
    }
    .subscribe-row button {
      font: inherit;
      font-weight: 600;
      padding: 0.5rem 1rem;
      white-space: nowrap;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    }
  </style>
</Base>
