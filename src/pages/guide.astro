---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatusPill from '../components/StatusPill.astro';
import { BUILDING_IMPACTS, IMPACT_KIND_LABELS } from '../data/complex/buildingImpacts';
import { COMMON_STRUCTURE_CHECKS, UNIT_GUIDE } from '../data/complex/unitGuide';
import { GEOMDAN_LAKEPARK, type UnitTypeCode } from '../data/presets/geomdan-lakepark';
import { formatKRW, formatRange } from '../lib/format';

const codes = Object.keys(UNIT_GUIDE) as UnitTypeCode[];
const types = codes.map((code) => ({
  guide: UNIT_GUIDE[code],
  ab22: GEOMDAN_LAKEPARK.blocks.AB22.types.find((type) => type.code === code)!,
  ab23: GEOMDAN_LAKEPARK.blocks.AB23.types.find((type) => type.code === code)!,
}));
const blocks = ['AB22', 'AB23'] as const;
---

<Base title="생활 정보" description="검단레이크파크 타입 차이와 동별 생활 영향을 공고 근거로 쉽게 정리합니다.">
  <header class="mb-10 max-w-3xl">
    <p class="mb-3 text-sm font-bold text-action">생활 정보</p>
    <h1 class="mb-4">도면보다 먼저 볼<br />타입과 동의 차이</h1>
    <p class="m-0 text-[1.05rem] leading-7 text-muted">공고에 적힌 사실과 생활 관점의 해석을 구분했습니다. 실제 가구 배치는 승인도면과 사전점검 실측으로 마지막 확인하세요.</p>
  </header>

  <section id="types" class="scroll-mt-32">
    <SectionHeader title="타입 한눈에 비교" description="가격은 공고 범위입니다. 정확한 동·층 금액은 계산기에서 찾을 수 있습니다." href="/calculator" linkLabel="내 가격 찾기" />
    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {types.map(({ guide, ab22, ab23 }) => (
        <article class="rounded-2xl border border-line p-5">
          <div class="flex items-baseline justify-between gap-3"><h2 class="m-0 text-3xl">{guide.code}</h2><span class="num text-sm font-bold text-muted">전용 {ab23.exclusiveAreaSqm.toFixed(2)}㎡</span></div>
          <p class="mb-4 mt-3 min-h-18 text-sm leading-6 text-muted">{guide.highlight}</p>
          <dl class="grid gap-2 border-y border-line py-3 text-xs">
            <div class="flex justify-between gap-3"><dt class="font-bold text-muted">AB22 공고가</dt><dd class="num m-0 text-right font-bold">{formatRange(ab22.supplyPrice)}</dd></div>
            <div class="flex justify-between gap-3"><dt class="font-bold text-muted">AB23 공고가</dt><dd class="num m-0 text-right font-bold">{formatRange(ab23.supplyPrice)}</dd></div>
            <div class="flex justify-between gap-3"><dt class="font-bold text-muted">AB23 확장비</dt><dd class="num m-0 text-right font-bold">{ab23.balconyExpansion ? formatKRW(ab23.balconyExpansion) : '확인 필요'}</dd></div>
          </dl>
          <details class="mt-4">
            <summary class="cursor-pointer text-sm font-bold text-action">선택 차이 자세히</summary>
            <div class="mt-4 text-sm leading-6">
              <p class="mb-2 font-extrabold"><StatusPill label="공고 확인" tone="green" /> 특징</p>
              <ul class="mt-0 pl-5 text-muted">{guide.confirmed.map((line) => <li class="mb-1">{line}</li>)}</ul>
              <p class="mb-2 mt-4 font-extrabold"><StatusPill label="생활 해석" tone="orange" /> 참고</p>
              <ul class="mb-0 mt-0 pl-5 text-muted">{guide.interpretation.map((line) => <li class="mb-1">{line}</li>)}</ul>
            </div>
          </details>
        </article>
      ))}
    </div>
  </section>

  <section id="buildings" class="mt-14 scroll-mt-32 border-t border-line pt-12">
    <SectionHeader title="우리 동 생활 영향" description="가격에는 반영하지 않은 공고상 생활 유의사항입니다." />
    <div class="mt-5 grid gap-4 lg:grid-cols-2">
      {blocks.map((block) => {
        const impacts = BUILDING_IMPACTS.filter((impact) => impact.block === block);
        return (
          <article class="rounded-2xl border border-line p-5">
            <div class="flex items-center justify-between"><h2 class="m-0 text-xl">{block}</h2><span class="text-xs font-bold text-muted">{impacts.length}개 항목</span></div>
            <div class="mt-4 divide-y divide-line border-t border-line">
              {impacts.map((impact) => (
                <div class="py-4">
                  <div class="flex flex-wrap items-center gap-2"><StatusPill label={IMPACT_KIND_LABELS[impact.kind]} tone="gray" /><strong class="num text-sm">{impact.buildings.length > 0 ? `${impact.buildings.join('·')}동` : '공통 위치'} {impact.location}</strong></div>
                  <p class="mb-0 mt-1 text-sm leading-6 text-muted">{impact.description}</p>
                </div>
              ))}
            </div>
          </article>
        );
      })}
    </div>
    <p class="mt-3 text-xs leading-5 text-muted">입주자모집공고 동별 유의사항(2026.06.12) 기준입니다. 위치는 시공 중 바뀔 수 있어 최종 배치도·준공도서를 확인해야 합니다.</p>
  </section>

  <section class="mt-14 border-t border-line pt-12">
    <SectionHeader title="사전점검 때 공통으로 볼 것" description="사진과 치수는 입주 준비 작업대에 바로 저장할 수 있습니다." href="/move-in#section-5" linkLabel="치수 기록 열기" />
    <ol class="mt-5 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-5">
      {COMMON_STRUCTURE_CHECKS.map((check, index) => <li class="list-none bg-white p-5"><span class="num text-xs font-extrabold text-action">0{index + 1}</span><p class="mb-0 mt-2 text-sm leading-6 text-muted">{check}</p></li>)}
    </ol>
  </section>
</Base>
