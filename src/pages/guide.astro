---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SourceBadge from '../components/SourceBadge.astro';
import UnitTypeCard from '../components/UnitTypeCard.astro';
import {
  BUILDING_IMPACTS,
  IMPACT_KIND_LABELS,
  IMPACTS_SOURCE,
  type BlockId,
} from '../data/complex/buildingImpacts';
import { COMMON_STRUCTURE_CHECKS, UNIT_GUIDE } from '../data/complex/unitGuide';
import { GEOMDAN_LAKEPARK, type UnitTypeCode } from '../data/presets/geomdan-lakepark';

const codes = Object.keys(UNIT_GUIDE) as UnitTypeCode[];
const cards = codes.map((code) => ({
  entry: UNIT_GUIDE[code],
  ab22: GEOMDAN_LAKEPARK.blocks.AB22.types.find((t) => t.code === code),
  ab23: GEOMDAN_LAKEPARK.blocks.AB23.types.find((t) => t.code === code),
}));

const BLOCKS: Array<{ id: BlockId; name: string }> = [
  { id: 'AB22', name: GEOMDAN_LAKEPARK.blocks.AB22.name },
  { id: 'AB23', name: GEOMDAN_LAKEPARK.blocks.AB23.name },
];

const impactsByBlock = BLOCKS.map((block) => ({
  ...block,
  impacts: BUILDING_IMPACTS.filter((impact) => impact.block === block.id),
}));
---

<Base title="타입·동 가이드" description="59A~84C 구조 비교와 공고에 적힌 동별 생활영향 요약">
  <h1>타입·동 가이드</h1>
  <p class="lede">
    모집공고에서 <span class="badge conf">확정</span>된 내용과 거기서 도출한
    <span class="badge est">의견</span>을 구분해 정리합니다. 평면 이미지는 저작권 문제로
    싣지 않습니다 — 도면은 계약 카탈로그와 공고 원문을 확인하세요.
  </p>

  <Hero
    image="guide-interior.jpg"
    optional
    alt="밝은 아파트 거실 인테리어"
  />

  <h2>타입별 구조 읽기</h2>
  <p class="hint">
    전용면적은 두 블록이 같고 주거공용 면적만 미세하게 다릅니다. 같은 타입이라도 동·호에 따라
    좌우대칭·방향·승강기 인접이 달라질 수 있습니다. 옵션 총액은
    <a href="/calculator">계산기</a>에서 바로 계산할 수 있습니다.
  </p>
  {cards.map((card) => <UnitTypeCard entry={card.entry} ab22={card.ab22} ab23={card.ab23} />)}

  <h2>동별 생활영향 (공고 명시)</h2>
  <p class="hint">
    모집공고 동별 유의사항에 직접 적힌 내용입니다. 위치는 시공 중 변경될 수 있으므로
    최종 배치도·준공도서 확인 전에는 확정으로 단정하지 마세요.
  </p>

  {
    impactsByBlock.map((block) => (
      <details class="card block-impacts">
        <summary>{block.name} — {block.impacts.length}개 항목</summary>
        <ul class="impact-list">
          {block.impacts.map((impact) => (
            <li class="impact-item">
              <span class="impact-kind">{IMPACT_KIND_LABELS[impact.kind]}</span>
              <span class="impact-where">
                {impact.buildings.length > 0 ? `${impact.buildings.join('·')}동` : ''}
                {impact.location && ` ${impact.location}`}
              </span>
              <span class="impact-desc">{impact.description}</span>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
  <p class="guide-source"><SourceBadge source={IMPACTS_SOURCE} /></p>

  <h2>층·위치별 공통 참고</h2>
  <details class="card">
    <summary>저층</summary>
    <ul class="floor-list">
      <li>출입구·필로티·중앙광장·놀이터·운동시설 이용자의 시선과 소음</li>
      <li>조경수·문주·옹벽·상가·환기구로 인한 조망·채광 간섭</li>
      <li>차량 출입구·경관조명·가로등의 빛과 알람 소음</li>
      <li>필로티 상부 세대의 바닥난방 효율 저하 가능성</li>
    </ul>
  </details>
  <details class="card">
    <summary>중층</summary>
    <ul class="floor-list">
      <li>놀이터·운동시설 소음은 거리에 따라 중층까지 전달될 수 있음</li>
      <li>승강기 샤프트 인접 침실의 운행음 확인 필요</li>
      <li>동 간 마주보기와 측면 창 시선 간섭 확인 필요</li>
    </ul>
  </details>
  <details class="card">
    <summary>고층·최상층</summary>
    <ul class="floor-list">
      <li>옥상 태양광 패널 반사와 경관·항공장애 조명 영향 가능</li>
      <li>옥탑 기계실·환기설비·통신중계기 인접 시 소음 가능</li>
      <li>주변 후속 개발로 조망이 달라질 수 있음</li>
    </ul>
  </details>

  <h2>전 타입 공통 체크</h2>
  <ul class="common-checks">
    {COMMON_STRUCTURE_CHECKS.map((check) => <li>{check}</li>)}
  </ul>

  <style>
    .lede {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin: 0 0 1.25rem;
    }
    .block-impacts summary {
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 600;
    }
    .impact-list {
      list-style: none;
      margin: 0.6rem 0 0;
      padding: 0;
    }
    .impact-item {
      display: flex;
      align-items: baseline;
      gap: 0.45rem;
      flex-wrap: wrap;
      padding: 0.45rem 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.92rem;
    }
    .impact-item:last-child {
      border-bottom: none;
    }
    .impact-kind {
      flex: none;
      font-size: 0.68rem;
      font-weight: 600;
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.05rem 0.4rem;
      white-space: nowrap;
    }
    .impact-where {
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .impact-desc {
      flex: 1 1 12rem;
      color: var(--text-muted);
    }
    .guide-source {
      margin: 0.5rem 0 0;
    }
    .floor-list,
    .common-checks {
      margin: 0.5rem 0 0;
      padding-left: 1.1rem;
      font-size: 0.94rem;
    }
    .floor-list li,
    .common-checks li {
      margin-bottom: 0.25rem;
    }
    details.card summary {
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 600;
    }
  </style>
</Base>
