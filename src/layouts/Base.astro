---
import { DISCLAIMER, SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.tagline } = Astro.props;
const pageTitle = title === SITE.name ? SITE.name : `${title} · ${SITE.name}`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><text y='26' font-size='26'>🏠</text></svg>" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
      crossorigin="anonymous"
    />
    {
      SITE.cloudflareAnalyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${SITE.cloudflareAnalyticsToken}"}`}
        />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">🏠</span>
          <span class="brand-text">{SITE.name}</span>
          <span class="brand-unofficial">비공식</span>
        </a>
        <nav aria-label="주요">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>홈</a>
          <a href="/status" aria-current={path === '/status' ? 'page' : undefined}>상태판</a>
          <a href="/guide" aria-current={path === '/guide' ? 'page' : undefined}>가이드</a>
          <a href="/timeline" aria-current={path === '/timeline' ? 'page' : undefined}>일정</a>
          <a href="/calculator" aria-current={path === '/calculator' ? 'page' : undefined}>계산기</a>
          <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>안내</a>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="disclaimer">{DISCLAIMER}</p>
        <p class="operator">
          {SITE.operator.label} · <a href="/about">운영 안내</a> ·
          <a href="/privacy">개인정보 처리방침</a>
        </p>
      </div>
    </footer>

    <nav class="tabbar" aria-label="하단 메뉴">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>
        <span class="tab-ico" aria-hidden="true">🏠</span><span>홈</span>
      </a>
      <a href="/status" aria-current={path === '/status' ? 'page' : undefined}>
        <span class="tab-ico" aria-hidden="true">🚧</span><span>상태판</span>
      </a>
      <a href="/guide" aria-current={path === '/guide' ? 'page' : undefined}>
        <span class="tab-ico" aria-hidden="true">🏢</span><span>가이드</span>
      </a>
      <a href="/timeline" aria-current={path === '/timeline' ? 'page' : undefined}>
        <span class="tab-ico" aria-hidden="true">📅</span><span>일정</span>
      </a>
      <a href="/calculator" aria-current={path === '/calculator' ? 'page' : undefined}>
        <span class="tab-ico" aria-hidden="true">🧮</span><span>계산기</span>
      </a>
    </nav>

    <style is:global>
      :root {
        --bg: #fdfdfc;
        --surface: #f6f7f9;
        --surface-2: #edeff3;
        --border: #e3e6ea;
        --text: #1b2129;
        --text-muted: #626c7a;
        --accent: #2563c4;
        --accent-soft: #e9f0fb;
        --accent-2: #2e8f6c;
        --confirmed: #15803d;
        --confirmed-soft: #e6f4ea;
        --estimated: #b45309;
        --estimated-soft: #fdf1e0;
        --warn: #b42318;
        --warn-soft: #fdeceb;
        --radius: 14px;
        --wrap: 62rem;
        --shadow-card: 0 1px 2px rgba(23, 32, 46, 0.04), 0 10px 28px -24px rgba(23, 32, 46, 0.25);
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #0f1216;
          --surface: #171b21;
          --surface-2: #1f242c;
          --border: #2c333d;
          --text: #e8ecf2;
          --text-muted: #9aa4b5;
          --accent: #7aa7f5;
          --accent-soft: #17233a;
          --accent-2: #5cc39a;
          --confirmed: #6ee7a0;
          --confirmed-soft: #122a1d;
          --estimated: #f0b464;
          --estimated-soft: #2c2013;
          --warn: #f88b82;
          --warn-soft: #2e1614;
          --shadow-card: 0 1px 2px rgba(0, 0, 0, 0.3), 0 10px 28px -24px rgba(0, 0, 0, 0.6);
        }
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family:
          'Pretendard Variable', 'Pretendard', -apple-system, BlinkMacSystemFont, 'Segoe UI',
          'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
        font-size: 1.0625rem;
        line-height: 1.75;
        letter-spacing: -0.011em;
        -webkit-text-size-adjust: 100%;
        -webkit-font-smoothing: antialiased;
        word-break: keep-all;
      }

      .wrap {
        width: 100%;
        max-width: var(--wrap);
        margin: 0 auto;
        padding: 0 1rem;
      }

      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 1rem;
        top: 1rem;
        z-index: 10;
        background: var(--accent);
        color: #fff;
        padding: 0.5rem 0.75rem;
        border-radius: var(--radius);
      }

      .site-header {
        border-bottom: 1px solid var(--border);
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
        z-index: 15;
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 3.75rem;
        flex-wrap: wrap;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--text);
        text-decoration: none;
      }
      .brand-mark {
        font-size: 1.25rem;
      }
      .brand-unofficial {
        font-size: 0.62rem;
        font-weight: 600;
        color: var(--text-muted);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.05rem 0.35rem;
        white-space: nowrap;
      }
      .site-header nav {
        display: flex;
        gap: 1rem;
        font-size: 0.9rem;
      }
      .site-header nav a {
        color: var(--text-muted);
        text-decoration: none;
      }
      .site-header nav a[aria-current='page'] {
        color: var(--accent);
        font-weight: 600;
      }
      .site-header nav a:hover {
        color: var(--text);
      }

      main {
        padding: 2rem 1rem 3rem;
      }

      h1 {
        font-size: clamp(1.65rem, 5vw, 2.25rem);
        font-weight: 800;
        line-height: 1.28;
        margin: 0 0 0.6rem;
        letter-spacing: -0.035em;
      }
      h2 {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 1.32rem;
        font-weight: 750;
        margin: 3rem 0 1rem;
        letter-spacing: -0.025em;
      }
      h2::before {
        content: '';
        flex: none;
        width: 0.32rem;
        height: 1.15em;
        border-radius: 999px;
        background: linear-gradient(180deg, var(--accent), var(--accent-2));
      }
      h3 {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 1.5rem 0 0.5rem;
        letter-spacing: -0.02em;
      }

      a {
        color: var(--accent);
      }

      .site-footer {
        border-top: 1px solid var(--border);
        background: var(--surface);
        padding: 1.75rem 0 2.5rem;
        font-size: 0.86rem;
        line-height: 1.7;
        color: var(--text-muted);
      }
      .site-footer .disclaimer {
        margin: 0 0 0.5rem;
      }
      .site-footer .operator {
        margin: 0;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
      }
      th,
      td {
        padding: 0.5rem 0.6rem;
        border-bottom: 1px solid var(--border);
        text-align: left;
      }
      th {
        font-weight: 600;
        color: var(--text-muted);
        font-size: 0.8rem;
        white-space: nowrap;
      }
      td.num,
      th.num {
        text-align: right;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }

      .scroll-x {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      .prose p,
      .prose li {
        font-size: 0.95rem;
      }
      .prose ul {
        padding-left: 1.1rem;
      }

      /*
       * 아래는 전역 스타일이어야 한다.
       * 계산기가 클라이언트에서 만들어 넣는 요소(옵션 체크박스, 가격 칩, 추정 표 행)에는
       * Astro의 스코프 속성(data-astro-cid-*)이 붙지 않아 스코프 스타일이 적용되지 않는다.
       */
      .muted {
        color: var(--text-muted);
      }
      .small {
        font-size: 0.8rem;
      }
      .hint {
        font-size: 0.84rem;
        color: var(--text-muted);
        margin: 0.35rem 0 0;
      }

      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 0.5rem;
      }
      .chip {
        font: inherit;
        font-size: 0.75rem;
        line-height: 1.35;
        text-align: left;
        padding: 0.35rem 0.55rem;
        background: var(--bg);
        color: var(--text-muted);
        border: 1px solid var(--border);
        border-radius: 8px;
        cursor: pointer;
      }
      .chip:hover {
        border-color: var(--accent);
        color: var(--text);
      }
      .chip .num {
        font-variant-numeric: tabular-nums;
        color: var(--text);
        font-weight: 600;
      }

      .check {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.87rem;
        padding: 0.3rem 0;
      }
      .check input {
        flex: none;
        width: 1rem;
        height: 1rem;
        accent-color: var(--accent);
      }
      .check > span:first-of-type {
        flex: 1 1 auto;
      }
      .check .num {
        margin-left: auto;
        font-variant-numeric: tabular-nums;
        font-size: 0.82rem;
        white-space: nowrap;
      }

      .badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.1rem 0.4rem;
        border-radius: 999px;
        vertical-align: middle;
      }
      .badge.conf {
        background: var(--confirmed-soft);
        color: var(--confirmed);
      }
      .badge.est {
        background: var(--estimated-soft);
        color: var(--estimated);
      }

      table.mini th,
      table.mini td {
        border: none;
        padding: 0.25rem 0;
        font-size: 0.85rem;
        white-space: normal;
      }
      table.mini th {
        font-weight: 500;
        color: var(--text-muted);
      }

      /* 여러 페이지가 공유하는 카드·폼 기본기. 페이지 스코프가 아닌 전역에 둔다. */
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.15rem 1.25rem 1.3rem;
        margin: 0 0 1rem;
        box-shadow: var(--shadow-card);
      }
      .card-title {
        font-size: 0.92rem;
        margin: 0 0 0.75rem;
        color: var(--text-muted);
        font-weight: 700;
        letter-spacing: 0.01em;
      }
      a.card {
        transition:
          border-color 0.15s ease,
          transform 0.15s ease;
      }
      a.card:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
      }
      @media (prefers-reduced-motion: reduce) {
        a.card {
          transition: none;
        }
        a.card:hover {
          transform: none;
        }
      }

      input[type='number'],
      input[type='date'],
      input[type='email'],
      select {
        width: 100%;
        padding: 0.5rem 0.6rem;
        font: inherit;
        font-variant-numeric: tabular-nums;
        color: var(--text);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
      }
      input:focus-visible,
      select:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }

      /* 모바일 하단 탭바 — 데스크톱에서는 숨기고 헤더 nav를 쓴다. */
      .tabbar {
        display: none;
      }
      @media (max-width: 40rem) {
        .site-header nav {
          display: none;
        }
        body {
          padding-bottom: calc(3.6rem + env(safe-area-inset-bottom));
        }
        .tabbar {
          position: fixed;
          bottom: 0;
          left: 0;
          right: 0;
          display: flex;
          background: color-mix(in srgb, var(--bg) 88%, transparent);
          backdrop-filter: blur(10px);
          border-top: 1px solid var(--border);
          padding-bottom: env(safe-area-inset-bottom);
          z-index: 20;
        }
        .tabbar a {
          flex: 1 1 0;
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 0.1rem;
          padding: 0.45rem 0 0.4rem;
          font-size: 0.66rem;
          color: var(--text-muted);
          text-decoration: none;
        }
        .tabbar a[aria-current='page'] {
          color: var(--accent);
          font-weight: 700;
        }
        .tab-ico {
          font-size: 1.15rem;
          line-height: 1;
        }
      }
    </style>
  </body>
</html>
