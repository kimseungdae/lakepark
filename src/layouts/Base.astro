---
import { DISCLAIMER, SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.tagline } = Astro.props;
const pageTitle = title === SITE.name ? SITE.name : `${title} · ${SITE.name}`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><text y='26' font-size='26'>🧮</text></svg>" />
    {
      SITE.cloudflareAnalyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${SITE.cloudflareAnalyticsToken}"}`}
        />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">🧮</span>
          <span class="brand-text">{SITE.name}</span>
        </a>
        <nav aria-label="주요">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>계산기</a>
          <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>안내</a>
          <a href="/privacy" aria-current={path === '/privacy' ? 'page' : undefined}>개인정보</a>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="disclaimer">{DISCLAIMER}</p>
        <p class="operator">
          {SITE.operator.label} · <a href="/about">운영 안내</a> ·
          <a href="/privacy">개인정보 처리방침</a>
        </p>
      </div>
    </footer>

    <style is:global>
      :root {
        --bg: #ffffff;
        --surface: #f7f8fa;
        --surface-2: #eef0f4;
        --border: #d9dde3;
        --text: #14181f;
        --text-muted: #5b6472;
        --accent: #1f5fd4;
        --accent-soft: #e8effc;
        --confirmed: #15803d;
        --confirmed-soft: #e6f4ea;
        --estimated: #b45309;
        --estimated-soft: #fdf1e0;
        --warn: #b42318;
        --warn-soft: #fdeceb;
        --radius: 10px;
        --wrap: 62rem;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #0f1216;
          --surface: #171b21;
          --surface-2: #1f242c;
          --border: #2c333d;
          --text: #e8ecf2;
          --text-muted: #98a2b3;
          --accent: #7aa7f5;
          --accent-soft: #17233a;
          --confirmed: #6ee7a0;
          --confirmed-soft: #122a1d;
          --estimated: #f0b464;
          --estimated-soft: #2c2013;
          --warn: #f88b82;
          --warn-soft: #2e1614;
        }
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family:
          'Pretendard', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Malgun Gothic',
          'Apple SD Gothic Neo', sans-serif;
        line-height: 1.65;
        -webkit-text-size-adjust: 100%;
      }

      .wrap {
        width: 100%;
        max-width: var(--wrap);
        margin: 0 auto;
        padding: 0 1rem;
      }

      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 1rem;
        top: 1rem;
        z-index: 10;
        background: var(--accent);
        color: #fff;
        padding: 0.5rem 0.75rem;
        border-radius: var(--radius);
      }

      .site-header {
        border-bottom: 1px solid var(--border);
        background: var(--surface);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 3.5rem;
        flex-wrap: wrap;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        color: var(--text);
        text-decoration: none;
      }
      .brand-mark {
        font-size: 1.25rem;
      }
      .site-header nav {
        display: flex;
        gap: 1rem;
        font-size: 0.9rem;
      }
      .site-header nav a {
        color: var(--text-muted);
        text-decoration: none;
      }
      .site-header nav a[aria-current='page'] {
        color: var(--accent);
        font-weight: 600;
      }
      .site-header nav a:hover {
        color: var(--text);
      }

      main {
        padding: 2rem 1rem 3rem;
      }

      h1 {
        font-size: clamp(1.5rem, 4vw, 2rem);
        line-height: 1.3;
        margin: 0 0 0.5rem;
        letter-spacing: -0.02em;
      }
      h2 {
        font-size: 1.2rem;
        margin: 2.5rem 0 0.75rem;
        letter-spacing: -0.01em;
      }
      h3 {
        font-size: 1rem;
        margin: 1.5rem 0 0.5rem;
      }

      a {
        color: var(--accent);
      }

      .site-footer {
        border-top: 1px solid var(--border);
        background: var(--surface);
        padding: 1.5rem 0 2.5rem;
        font-size: 0.82rem;
        color: var(--text-muted);
      }
      .site-footer .disclaimer {
        margin: 0 0 0.5rem;
      }
      .site-footer .operator {
        margin: 0;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
      }
      th,
      td {
        padding: 0.5rem 0.6rem;
        border-bottom: 1px solid var(--border);
        text-align: left;
      }
      th {
        font-weight: 600;
        color: var(--text-muted);
        font-size: 0.8rem;
        white-space: nowrap;
      }
      td.num,
      th.num {
        text-align: right;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }

      .scroll-x {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      .prose p,
      .prose li {
        font-size: 0.95rem;
      }
      .prose ul {
        padding-left: 1.1rem;
      }

      /*
       * 아래는 전역 스타일이어야 한다.
       * 계산기가 클라이언트에서 만들어 넣는 요소(옵션 체크박스, 가격 칩, 추정 표 행)에는
       * Astro의 스코프 속성(data-astro-cid-*)이 붙지 않아 스코프 스타일이 적용되지 않는다.
       */
      .muted {
        color: var(--text-muted);
      }
      .small {
        font-size: 0.8rem;
      }
      .hint {
        font-size: 0.78rem;
        color: var(--text-muted);
        margin: 0.35rem 0 0;
      }

      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 0.5rem;
      }
      .chip {
        font: inherit;
        font-size: 0.75rem;
        line-height: 1.35;
        text-align: left;
        padding: 0.35rem 0.55rem;
        background: var(--bg);
        color: var(--text-muted);
        border: 1px solid var(--border);
        border-radius: 8px;
        cursor: pointer;
      }
      .chip:hover {
        border-color: var(--accent);
        color: var(--text);
      }
      .chip .num {
        font-variant-numeric: tabular-nums;
        color: var(--text);
        font-weight: 600;
      }

      .check {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.87rem;
        padding: 0.3rem 0;
      }
      .check input {
        flex: none;
        width: 1rem;
        height: 1rem;
        accent-color: var(--accent);
      }
      .check > span:first-of-type {
        flex: 1 1 auto;
      }
      .check .num {
        margin-left: auto;
        font-variant-numeric: tabular-nums;
        font-size: 0.82rem;
        white-space: nowrap;
      }

      .badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.1rem 0.4rem;
        border-radius: 999px;
        vertical-align: middle;
      }
      .badge.conf {
        background: var(--confirmed-soft);
        color: var(--confirmed);
      }
      .badge.est {
        background: var(--estimated-soft);
        color: var(--estimated);
      }

      table.mini th,
      table.mini td {
        border: none;
        padding: 0.25rem 0;
        font-size: 0.85rem;
        white-space: normal;
      }
      table.mini th {
        font-weight: 500;
        color: var(--text-muted);
      }
    </style>
  </body>
</html>
